# # # IPv4 Address [ipconfig]
# # Vào cmd gõ ipconfig phần Wireless LAN adapter Wi-Fi để lấy địa chỉ Ipv4 của máy rồi gắn vô đường dẫn
# # Hoặc lấy hostman để vào cx ok
#LOCALHOST = http://laptop:3000 #Tay
#LOCALHOST = http://MSI:3000
LOCALHOST = http://localhost:3000
DEV_HOSTNAME=MSI
#DEV_HOSTNAME=laptop #Tay
SOCKET_URL=http://${DEV_HOSTNAME}:3000
API_URL=http://${DEV_HOSTNAME}:3000/api

